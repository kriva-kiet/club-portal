# ─── Firebase & Cloud ─────────────────────────────────────────────────────────
# Never commit your real Firebase config files (any location in tree)
**/google-services.json
google-services.json
android/app/google-services.json

**/GoogleService-Info.plist
GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# FlutterFire generated config — contains real API keys
lib/firebase_options.dart

# Firebase Auth exports / User dumps / Service Accounts (CRITICAL SECURITY)
accounts*.json
*serviceAccount*.json
*service-account*.json
*-adminsdk-*.json
credentials.json
client_secret*.json

# Firebase CLI & emulator logs
.firebase/
firebase.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Web Firebase messaging service worker (contains live credentials)
web/firebase-messaging-sw.js
!web/firebase-messaging-sw.example.js

# Firestore Security Rules (avoid exposing internal database permissions)
firestore.rules
!firestore.rules.example

